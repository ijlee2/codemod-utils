{
  "name": "my-codemod",
  "version": "0.0.0",
  "private": true,
  "description": "Small description for my-codemod goes here",
  "keywords": [
    "codemod",
    "ember-codemod",
    "emberjs"
  ],
  "repository": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": "dist/bin/my-codemod.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "sh build.sh --production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "pnpm build",
    "release:prepare": "changeset version",
    "release:publish": "pnpm build && changeset publish",
    "test": "sh build.sh --test && mt dist-for-testing --quiet"
  },
  "dependencies": {
    "@codemod-utils/files": "^4.1.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@codemod-utils/tests": "^3.3.0",
    "@ijlee2-frontend-configs/changesets": "^3.0.2",
    "@ijlee2-frontend-configs/eslint-config-node": "^4.3.0",
    "@ijlee2-frontend-configs/prettier": "^3.4.0",
    "@ijlee2-frontend-configs/typescript": "^4.1.0",
    "@types/node": "^22.20.4",
    "@types/yargs": "^17.0.35",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "22.* || >= 24"
  }
}
