{
  "name": "my-codemod",
  "version": "0.0.0",
  "private": true,
  "description": "Small description for my-codemod goes here",
  "keywords": [
    "codemod",
    "ember-codemod",
    "emberjs"
  ],
  "repository": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "src/index.js",
  "bin": "bin/my-codemod.js",
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "format": "prettier . --cache --write",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "release:prepare": "changeset version",
    "release:publish": "changeset publish",
    "test": "mt tests --quiet"
  },
  "dependencies": {
    "@codemod-utils/files": "^4.1.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@codemod-utils/tests": "^3.3.0",
    "@ijlee2-frontend-configs/changesets": "^3.0.3",
    "@ijlee2-frontend-configs/eslint-config-node": "^4.8.0",
    "@ijlee2-frontend-configs/prettier": "^3.4.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "22.* || >= 24"
  }
}
