{
  "name": "@my-org/my-codemod",
  "version": "0.0.0",
  "private": true,
  "description": "Small description for @my-org/my-codemod goes here",
  "keywords": [
    "codemod",
    "ember-codemod",
    "emberjs"
  ],
  "repository": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": "dist/bin/my-codemod.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "sh build.sh --production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "pnpm build",
    "release:prepare": "changeset version",
    "release:publish": "pnpm build && changeset publish",
    "test": "sh build.sh --test && mt dist-for-testing --quiet"
  },
  "dependencies": {
    "@codemod-utils/ast-javascript": "^4.3.2",
    "@codemod-utils/ast-template": "^4.1.0",
    "@codemod-utils/ast-template-tag": "^2.7.0",
    "@codemod-utils/blueprints": "^3.2.0",
    "@codemod-utils/ember": "^4.2.0",
    "@codemod-utils/files": "^4.1.0",
    "@codemod-utils/package-json": "^4.1.0",
    "@codemod-utils/threads": "^1.1.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@codemod-utils/tests": "^3.3.0",
    "@ijlee2-frontend-configs/changesets": "^3.0.1",
    "@ijlee2-frontend-configs/eslint-config-node": "^4.2.3",
    "@ijlee2-frontend-configs/prettier": "^3.3.4",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.20.1",
    "@types/yargs": "^17.0.35",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "22.* || >= 24"
  }
}
