    "@codemod-utils/ember": "^4.2.1",
    "@codemod-utils/files": "^4.1.2",
    "@codemod-utils/package-json": "^4.1.4",
    "@codemod-utils/threads": "^1.1.2",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@codemod-utils/tests": "^3.3.1",
