{
  "name": "@codemod-utils/package-json",
  "version": "4.1.3",
  "description": "Utilities for handling package.json",
  "keywords": [
    "codemod",
    "ember-codemod"
  ],
  "homepage": "https://codemod-utils.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git@github.com:ijlee2/codemod-utils.git",
    "directory": "packages/package-json"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "sh build.sh --production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "lint:types": "tsc --noEmit",
    "test": "sh build.sh --test && mt dist-for-testing --quiet"
  },
  "dependencies": {
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@codemod-utils/tests": "workspace:*",
    "@shared-configs/oxlint-node": "workspace:*",
    "@shared-configs/prettier": "workspace:*",
    "@shared-configs/typescript": "workspace:*",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
